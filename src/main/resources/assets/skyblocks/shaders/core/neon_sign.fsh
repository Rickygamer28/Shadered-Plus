        d = min(d, sg(p, vec2(0.669, 5.786), vec2(0.502, 5.724)));
        d = min(d, sg(p, vec2(0.502, 5.724), vec2(0.354, 5.616)));
        d = min(d, sg(p, vec2(0.354, 5.616), vec2(0.234, 5.470)));
        d = min(d, sg(p, vec2(0.234, 5.470), vec2(0.149, 5.294)));
        d = min(d, sg(p, vec2(0.149, 5.294), vec2(0.106, 5.100)));
        d = min(d, sg(p, vec2(0.106, 5.100), vec2(0.106, 4.900)));
        d = min(d, sg(p, vec2(0.106, 4.900), vec2(0.149, 4.706)));
        d = min(d, sg(p, vec2(0.149, 4.706), vec2(0.234, 4.530)));
        d = min(d, sg(p, vec2(0.234, 4.530), vec2(0.354, 4.384)));
        d = min(d, sg(p, vec2(0.354, 4.384), vec2(0.502, 4.276)));
        d = min(d, sg(p, vec2(0.502, 4.276), vec2(0.669, 4.214)));
        d = min(d, sg(p, vec2(0.669, 4.214), vec2(0.844, 4.202)));
        d = min(d, sg(p, vec2(0.844, 4.202), vec2(1.016, 4.239)));
        d = min(d, sg(p, vec2(1.016, 4.239), vec2(1.175, 4.325)));
        d = min(d, sg(p, vec2(1.175, 4.325), vec2(1.310, 4.452)));
        d = min(d, sg(p, vec2(1.310, 4.452), vec2(1.413, 4.615)));
        d = min(d, sg(p, vec2(1.413, 4.615), vec2(1.478, 4.801)));
        d = min(d, sg(p, vec2(1.478, 4.801), vec2(1.500, 5.000)));
        d = min(d, sg(p, vec2(3.900, 1.000), vec2(3.878, 1.199)));
        d = min(d, sg(p, vec2(3.878, 1.199), vec2(3.813, 1.385)));
        d = min(d, sg(p, vec2(3.813, 1.385), vec2(3.710, 1.548)));
        d = min(d, sg(p, vec2(3.710, 1.548), vec2(3.575, 1.675)));
        d = min(d, sg(p, vec2(3.575, 1.675), vec2(3.416, 1.761)));
        d = min(d, sg(p, vec2(3.416, 1.761), vec2(3.244, 1.798)));
        d = min(d, sg(p, vec2(3.244, 1.798), vec2(3.069, 1.786)));
        d = min(d, sg(p, vec2(3.069, 1.786), vec2(2.902, 1.724)));
        d = min(d, sg(p, vec2(2.902, 1.724), vec2(2.754, 1.616)));
        d = min(d, sg(p, vec2(2.754, 1.616), vec2(2.634, 1.470)));
        d = min(d, sg(p, vec2(2.634, 1.470), vec2(2.549, 1.294)));
        d = min(d, sg(p, vec2(2.549, 1.294), vec2(2.506, 1.100)));
        d = min(d, sg(p, vec2(2.506, 1.100), vec2(2.506, 0.900)));
        d = min(d, sg(p, vec2(2.506, 0.900), vec2(2.549, 0.706)));
        d = min(d, sg(p, vec2(2.549, 0.706), vec2(2.634, 0.530)));
        d = min(d, sg(p, vec2(2.634, 0.530), vec2(2.754, 0.384)));
        d = min(d, sg(p, vec2(2.754, 0.384), vec2(2.902, 0.276)));
        d = min(d, sg(p, vec2(2.902, 0.276), vec2(3.069, 0.214)));
        d = min(d, sg(p, vec2(3.069, 0.214), vec2(3.244, 0.202)));
        d = min(d, sg(p, vec2(3.244, 0.202), vec2(3.416, 0.239)));
        d = min(d, sg(p, vec2(3.416, 0.239), vec2(3.575, 0.325)));
        d = min(d, sg(p, vec2(3.575, 0.325), vec2(3.710, 0.452)));
        d = min(d, sg(p, vec2(3.710, 0.452), vec2(3.813, 0.615)));
        d = min(d, sg(p, vec2(3.813, 0.615), vec2(3.878, 0.801)));
        d = min(d, sg(p, vec2(3.878, 0.801), vec2(3.900, 1.000)));
    }
    else if (c == 94) {
        d = min(d, sg(p, vec2(0.400, 4.400), vec2(2.000, 6.000)));
        d = min(d, sg(p, vec2(2.000, 6.000), vec2(3.600, 4.400)));
    }
    else if (c == 34) {
        d = min(d, sg(p, vec2(0.600, 6.000), vec2(0.600, 4.600)));
        d = min(d, sg(p, vec2(1.800, 6.000), vec2(1.800, 4.600)));
    }
    else if (c == 59) {
        d = min(d, sg(p, vec2(0.800, 3.250), vec2(0.800, 3.350)));
        d = min(d, sg(p, vec2(0.800, 0.500), vec2(0.300, -0.900)));
    }
    return d;
}

void main() {
    int c = int(vColor.a * 255.0 + 0.5);
    float d = neonGlyph(c, uv);
    float r = 0.26;
    float core = 1.0 - smoothstep(r * 0.3, r, d);
    float g = max(d - r * 0.5, 0.0);
    float glow = exp(-g * 2.4) * 1.05 + exp(-g * 0.8) * 0.35;
    vec3 tube = vColor.rgb;
    float rim = (1.0 - smoothstep(r * 0.6, r * 1.25, d)) - core; // (the bright coloured edge of the tube)
    vec3 hot = mix(tube * 1.5, vec3(1.0), 0.55);                 // (the tube's middle: nearly white-hot)
    vec3 col = tube * glow + hot * core * 1.5 + tube * 1.4 * max(rim, 0.0);
    fragColor = vec4(col, 1.0);
}
