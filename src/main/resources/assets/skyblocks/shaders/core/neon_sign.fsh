#version 150

// Shadered+'s neon sign (our own code): each letter is a bent glass tube - its centre lines are the strokes of our own
// single-stroke font (tools/make_neon_font.py). One quad per letter, a little bigger than it for the glow; the
// distance to the strokes gives the bright tube (nearly white in the middle) and the coloured light round it.
// UV0 = the point in font units (letters 6 tall); Color = the tube's colour (dimmer when it flickers), alpha = the letter.

in vec2 uv;
in vec4 vColor;

out vec4 fragColor;

float sg(vec2 p, vec2 a, vec2 b) {
    vec2 pa = p - a, ba = b - a;
    float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1.0e-6), 0.0, 1.0);
    return length(pa - ba * h);
}

