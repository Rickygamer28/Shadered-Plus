{
  "multipart": [
    {
      "apply": {
        "model": "skyblocks:block/vanilla_aquarium_glass"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "skyblocks:block/vanilla_aquarium_water"
      }
    },
    {
      "when": {
        "up": "false"
      },
      "apply": {
        "model": "skyblocks:block/vanilla_aquarium_water_top"
      }
    },
    {
      "when": {
        "down": "false"
      },
      "apply": {
        "model": "skyblocks:block/vanilla_aquarium_sand"
      }
    }
  ]
}