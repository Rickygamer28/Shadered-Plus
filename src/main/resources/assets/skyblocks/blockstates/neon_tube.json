{
  "multipart": [
    {
      "apply": {
        "model": "skyblocks:block/neon_tube_core"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "skyblocks:block/neon_tube_north"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "skyblocks:block/neon_tube_south"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "skyblocks:block/neon_tube_west"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "skyblocks:block/neon_tube_east"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "skyblocks:block/neon_tube_down"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "skyblocks:block/neon_tube_up"
      }
    }
  ]
}