{
  "multipart": [
    {
      "apply": {
        "model": "skyblocks:block/koi_pond_base"
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "skyblocks:block/koi_pond_north"
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "skyblocks:block/koi_pond_south"
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "skyblocks:block/koi_pond_west"
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "skyblocks:block/koi_pond_east"
      }
    }
  ]
}