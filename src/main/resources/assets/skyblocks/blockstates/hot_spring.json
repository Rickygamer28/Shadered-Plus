{
  "multipart": [
    {
      "apply": {
        "model": "skyblocks:block/hot_spring_base"
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "skyblocks:block/hot_spring_north"
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "skyblocks:block/hot_spring_south"
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "skyblocks:block/hot_spring_west"
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "skyblocks:block/hot_spring_east"
      }
    }
  ]
}